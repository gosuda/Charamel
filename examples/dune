; One independent native target per program. The bubbletea_examples dispatcher
; depends only on the bubbletea example library, so building it never pulls in
; Huh or the SSH tier.

(executable
 (name bubbletea_examples)
 (modules bubbletea_examples)
 (libraries bubbletea lwt lwt.unix unix))

(executable
 (name huh_burger)
 (modules huh_burger)
 (libraries charamel.huh charamel.tea charamel.os lwt lwt.unix fmt))

(executable
 (name wish_counter)
 (modules wish_counter)
 (libraries
  charamel-ssh.wish
  charamel-ssh.keygen
  charamel.tea
  charamel.cli
  charamel.os
  lwt
  lwt.unix
  unix
  fmt
  mirage-crypto-rng.unix))

(executable
 (name confetti)
 (modules confetti)
 (libraries
  charamel-ssh.wish
  charamel-ssh.keygen
  charamel.tea
  charamel.cli
  charamel.os
  lwt
  lwt.unix
  unix
  fmt
  mtime
  mirage-crypto-rng.unix))
