; One independent native target per example. The Tea examples depend on
; nothing but charamel.tea and the Eio stack, so building them never pulls in
; Huh or the SSH tier.

(executable
 (name tea_counter)
 (modules tea_counter)
 (libraries charamel.tea eio eio.unix eio_main fmt))

(executable
 (name tea_inline)
 (modules tea_inline)
 (libraries charamel.tea eio eio.unix eio_main fmt mtime))

(executable
 (name huh_burger)
 (modules huh_burger)
 (libraries charamel.huh charamel.tea eio eio.unix eio_main fmt))

(executable
 (name wish_counter)
 (modules wish_counter)
 (libraries
  charamel-ssh.wish
  charamel-ssh.keygen
  charamel.tea
  eio
  eio.unix
  eio_main
  fmt
  mirage-crypto-rng.unix))

(executable
 (name confetti)
 (modules confetti)
 (libraries
  charamel-ssh.wish
  charamel-ssh.keygen
  charamel.tea
  eio
  eio.unix
  eio_main
  fmt
  mtime
  mirage-crypto-rng.unix))
