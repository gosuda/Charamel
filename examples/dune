; One independent native target per example. The Tea examples depend on
; nothing but charamel.tea and the Lwt stack, so building them never pulls in
; Huh or the SSH tier.

(executable
 (name tea_counter)
 (modules tea_counter)
 (libraries charamel.tea charamel.os lwt lwt.unix fmt))

(executable
 (name tea_inline)
 (modules tea_inline)
 (libraries charamel.tea charamel.os lwt lwt.unix fmt mtime))

(executable
 (name huh_burger)
 (modules huh_burger)
 (libraries charamel.huh charamel.tea charamel.os lwt lwt.unix fmt))

(executable
 (name wish_counter)
 (modules wish_counter)
 (libraries
  charamel-ssh.wish
  charamel-ssh.keygen
  charamel.tea
  charamel.cli
  charamel.os
  lwt
  lwt.unix
  unix
  fmt
  mirage-crypto-rng.unix))

(executable
 (name confetti)
 (modules confetti)
 (libraries
  charamel-ssh.wish
  charamel-ssh.keygen
  charamel.tea
  charamel.cli
  charamel.os
  lwt
  lwt.unix
  unix
  fmt
  mtime
  mirage-crypto-rng.unix))
