; sc_01.ml .. sc_05.ml and goal_fixture.ml/.mli are the acceptance-scenario
; suite for the ten app binaries. They run under `dune build @goals`, which no
; other gate depends on: `dune runtest` does not reach this alias.

(executable
 (name sc_all)
 (libraries alcotest charm.ansi eio eio.unix eio_main unix fmt)
 (modules sc_all sc_01 sc_02 sc_03 sc_04 sc_05 goal_fixture)
 (flags
  (:standard
   -strict-sequence
   -strict-formats
   -short-paths
   -principal
   -w
   +a-4-9-29-30-40..42-44..46-48-58-66-67)))

(rule
 (alias goals)
 (deps
  %{exe:../../bin/gum/main.exe}
  %{exe:../../bin/glow/main.exe}
  %{exe:../../bin/keygen/main.exe}
  %{exe:../../bin/crush/main.exe})
 (action
  (run ./sc_all.exe)))
